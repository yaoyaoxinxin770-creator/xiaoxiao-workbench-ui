diff --git a/infinite-canvas/web/src/app/workbench-v3.css b/infinite-canvas/web/src/app/workbench-v3.css
new file mode 100644
index 0000000..a7ab5c4
--- /dev/null
+++ b/infinite-canvas/web/src/app/workbench-v3.css
@@ -0,0 +1,974 @@
+/* =========================================================================
+   晓晓工作台 · 第 2 轮视觉层（workbench-v3）
+   - 四套皮肤：暖樱粉（默认 · 柔粉精修）、云母白（雾白工作室）、影视暗房（胭脂墨黑）、漫画分镜
+   - 动效与衔接：Agent 侧栏 ↔ 视频台、提示词浮层、视频卡片、资产与项目卡片
+   只改外观，不改变 DOM 结构约定与交互：选择器全部基于现有 data-* / class 钩子。
+   在 layout.tsx 中于 globals.css 之后引入；减少动态效果的系统设置由 globals.css 统一处理。
+   ========================================================================= */
+
+/* ---------- 0. 通用动效与表面变量 ---------- */
+:root {
+    --wb-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
+    --wb-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
+    --wb-dur-fast: 0.12s;
+    --wb-dur: 0.18s;
+    --wb-dur-slow: 0.28s;
+    --wb-glass: color-mix(in srgb, var(--card) 88%, transparent);
+    --wb-glass-line: color-mix(in srgb, var(--foreground) 8%, transparent);
+    --wb-float: var(--shadow-lg);
+    --wb-live: var(--primary);
+    --wb-ok: #2f9e62;
+    --wb-warn: #d58a1a;
+    --wb-tile: var(--secondary);
+    --wb-cta: var(--primary);
+}
+
+/* ---------- 1. 皮肤变量 ---------- */
+/* 影视暗房（neutral + dark）：胭脂粉 #FF7CA2 × 墨黑 #000000 撞色。整块胭脂粉 + 黑字只用于选中、主操作和关键状态。 */
+html:root[data-skin="neutral"].dark {
+    --background: #000000;
+    --foreground: #f7f3f5;
+    --card: #0b0b0c;
+    --card-foreground: #f7f3f5;
+    --popover: #111113;
+    --popover-foreground: #f7f3f5;
+    --primary: #ff7ca2;
+    --primary-foreground: #000000;
+    --secondary: #141416;
+    --secondary-foreground: #c4bcc0;
+    --muted: #141416;
+    --muted-foreground: #8e868b;
+    --accent: #2a1520;
+    --accent-foreground: #ff9dba;
+    --destructive: #ff6b6b;
+    --border: rgba(255, 255, 255, 0.1);
+    --input: rgba(255, 255, 255, 0.17);
+    --ring: #ff7ca2;
+    --gold: #ff7ca2;
+    --wb-rail: #000000;
+    --wb-info: #ff7ca2;
+    --wb-scrim: rgba(0, 0, 0, 0.78);
+    --sidebar: #0b0b0c;
+    --sidebar-foreground: #f7f3f5;
+    --sidebar-primary: #ff7ca2;
+    --sidebar-primary-foreground: #000000;
+    --sidebar-accent: #2a1520;
+    --sidebar-accent-foreground: #ff9dba;
+    --sidebar-border: rgba(255, 255, 255, 0.1);
+    --sidebar-ring: #ff7ca2;
+    --glow: 0 0 0 3px rgba(255, 124, 162, 0.28);
+    --shadow-sm: 0 0 0 1px rgba(255, 255, 255, 0.06);
+    --shadow-md: 0 10px 28px -12px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.06);
+    --shadow-lg: 0 28px 80px -24px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 124, 162, 0.16);
+    --wb-card-shadow: 0 0 0 1px rgba(255, 124, 162, 0.35), 0 18px 40px -18px rgba(0, 0, 0, 0.9);
+    --wb-panel-shadow: 0 -8px 30px rgba(0, 0, 0, 0.8);
+    --wb-glass: rgba(10, 10, 12, 0.9);
+    --wb-glass-line: rgba(255, 124, 162, 0.22);
+    --wb-float: 0 0 0 1px rgba(255, 124, 162, 0.22), 0 30px 90px -20px rgba(0, 0, 0, 0.95), 0 0 70px -32px rgba(255, 124, 162, 0.6);
+    --wb-tile: #111113;
+    --wb-ok: #4ade80;
+    --wb-warn: #f5b547;
+}
+/* 云母白（neutral + light）：雾白工作室 —— 中性灰阶 + 靛蓝强调，开始按钮墨黑。 */
+html:root[data-skin="neutral"]:not(.dark) {
+    --background: #f5f5f6;
+    --foreground: #18181b;
+    --card: #ffffff;
+    --card-foreground: #18181b;
+    --popover: #ffffff;
+    --popover-foreground: #18181b;
+    --primary: #5b5bd6;
+    --primary-foreground: #ffffff;
+    --secondary: #f0f0f2;
+    --secondary-foreground: #52525b;
+    --muted: #f0f0f2;
+    --muted-foreground: #71717a;
+    --accent: #eeeefc;
+    --accent-foreground: #3e3ea8;
+    --border: #e4e4e7;
+    --input: #d4d4d8;
+    --ring: #5b5bd6;
+    --gold: #5b5bd6;
+    --wb-rail: #fafafa;
+    --wb-info: #5b5bd6;
+    --sidebar: #ffffff;
+    --sidebar-accent: #eeeefc;
+    --sidebar-accent-foreground: #3e3ea8;
+    --sidebar-border: #e4e4e7;
+    --glow: 0 0 0 3px rgba(91, 91, 214, 0.16);
+    --shadow-sm: 0 1px 2px rgba(24, 24, 27, 0.05);
+    --shadow-md: 0 8px 24px -12px rgba(24, 24, 27, 0.22);
+    --shadow-lg: 0 22px 60px -22px rgba(24, 24, 27, 0.3), 0 0 0 1px rgba(24, 24, 27, 0.05);
+    --wb-card-shadow: 0 10px 28px -14px rgba(24, 24, 27, 0.28);
+    --wb-glass: rgba(255, 255, 255, 0.95);
+    --wb-glass-line: rgba(24, 24, 27, 0.08);
+    --wb-tile: #e8e8eb;
+    --wb-cta: #18181b;
+}
+/* 漫画分镜（comic）：米白纸张、墨线硬投影、番茄红主色、明黄高亮。 */
+html:root[data-skin="comic"]:not(.dark),
+html:root[data-skin="comic"].dark {
+    --skin-stone-50: #fffdf7;
+    --skin-stone-100: #f8f0de;
+    --skin-stone-200: #ede2c8;
+    --skin-stone-300: #d9ccb0;
+    --skin-stone-400: #ab9d7f;
+    --skin-stone-500: #857a62;
+    --skin-stone-600: #665d4b;
+    --skin-stone-700: #4a443a;
+    --skin-stone-800: #2f2b25;
+    --skin-stone-900: #1b1a17;
+    --skin-stone-950: #0f0e0c;
+    --background: #fbf5e9;
+    --foreground: #1b1a17;
+    --card: #fffdf7;
+    --card-foreground: #1b1a17;
+    --popover: #fffdf7;
+    --popover-foreground: #1b1a17;
+    --primary: #e8452c;
+    --primary-foreground: #ffffff;
+    --secondary: #f3e9d4;
+    --secondary-foreground: #4a463d;
+    --muted: #f3e9d4;
+    --muted-foreground: #6e6858;
+    --accent: #ffe9a8;
+    --accent-foreground: #1b1a17;
+    --destructive: #c5361f;
+    --border: #cdbf9f;
+    --input: #bfae86;
+    --ring: #1b1a17;
+    --gold: #ffc93c;
+    --wb-rail: #1b1a17;
+    --wb-info: #e8452c;
+    --sidebar: #fffdf7;
+    --sidebar-accent: #ffe9a8;
+    --sidebar-accent-foreground: #1b1a17;
+    --sidebar-border: #cdbf9f;
+    --glow: 3px 3px 0 #1b1a17;
+    --shadow-sm: 2px 2px 0 rgba(27, 26, 23, 0.85);
+    --shadow-md: 3px 3px 0 #1b1a17;
+    --shadow-lg: 5px 5px 0 #1b1a17;
+    --wb-card-shadow: 4px 4px 0 #1b1a17;
+    --wb-glass: #fffdf7;
+    --wb-glass-line: #1b1a17;
+    --wb-float: 6px 6px 0 #1b1a17;
+    --wb-tile: #e9dfc8;
+    --wb-ink: #1b1a17;
+    --wb-dots: radial-gradient(rgba(27, 26, 23, 0.08) 1px, transparent 1.3px) 0 0 / 9px 9px;
+    color-scheme: light;
+}
+html:root[data-skin="comic"] body::before,
+html:root[data-skin="comic"] body::after {
+    background: none;
+}
+
+/* ---------- 2. 顶部栏与功能栏 ---------- */
+[data-workspace-tabs] > div {
+    transition:
+        background var(--wb-dur) var(--wb-ease),
+        color var(--wb-dur) var(--wb-ease),
+        box-shadow var(--wb-dur) var(--wb-ease);
+}
+[data-workspace-tabs] > div:not([data-active="true"]):hover {
+    background: color-mix(in srgb, var(--foreground) 5%, transparent);
+}
+.workspace-task-status {
+    font-variant-numeric: tabular-nums;
+    box-shadow: 0 0 18px -10px var(--wb-info);
+}
+.workbench-rail nav a {
+    position: relative;
+    transition:
+        background var(--wb-dur) var(--wb-ease),
+        color var(--wb-dur) var(--wb-ease),
+        transform var(--wb-dur-fast) var(--wb-ease),
+        box-shadow var(--wb-dur) var(--wb-ease);
+}
+.workbench-rail nav a:active {
+    transform: scale(0.96);
+}
+.workbench-rail nav a svg {
+    transition: transform var(--wb-dur) var(--wb-ease);
+}
+.workbench-rail nav a:hover svg {
+    transform: translateY(-1px);
+}
+
+/* ---------- 3. 项目目录栏与工具栏 ---------- */
+.project-section-switch button {
+    transition:
+        background var(--wb-dur) var(--wb-ease),
+        color var(--wb-dur) var(--wb-ease),
+        box-shadow var(--wb-dur) var(--wb-ease);
+}
+[data-video-studio] > aside .ant-tree-node-content-wrapper {
+    transition:
+        background var(--wb-dur) var(--wb-ease),
+        color var(--wb-dur) var(--wb-ease);
+}
+[data-toolbar-actions] {
+    align-items: center;
+    row-gap: 8px !important;
+}
+[data-toolbar-group]:empty {
+    display: none;
+}
+/* 分隔线画在两组之间原有的 8px 间隙里，不增加宽度：工具栏宽度与 0.5.23 相同（本机界面检查要求 1440 宽窗口下高度 ≤56px）。 */
+[data-toolbar-group="view"] {
+    position: relative;
+}
+[data-toolbar-group="create"]:not(:empty) + [data-toolbar-group="view"]::before {
+    content: "";
+    position: absolute;
+    left: -4.5px;
+    top: 6px;
+    bottom: 6px;
+    width: 1px;
+    background: var(--border);
+}
+/* 开关类按钮开启时外圈柔光，不占布局空间。 */
+[data-auto-match-toggle][aria-pressed="true"],
+[data-agent-toggle][aria-pressed="true"] {
+    box-shadow: 0 0 22px -8px var(--primary) !important;
+}
+
+/* 切换文件夹、项目或“视频 / 资产”时内容轻微淡入（仅在挂载或重新显示时播放一次）。 */
+[data-video-gallery],
+[data-video-elements] {
+    animation: wb-fade-up 0.28s var(--wb-ease-out) backwards;
+}
+
+/* ---------- 4. 视频卡片（直角纯画面，只增加悬停与状态表现） ---------- */
