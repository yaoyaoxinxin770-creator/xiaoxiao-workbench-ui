+    transition-delay: 0s, 30ms, 0s, 0s;
+}
+[data-video-actions] > button:nth-child(3) {
+    transition-delay: 0s, 60ms, 0s, 0s;
+}
+[data-video-tile]:hover [data-video-actions] > button,
+[data-video-tile]:focus-within [data-video-actions] > button,
+[data-video-actions] > button[aria-pressed="true"] {
+    transform: none;
+}
+/* 已收藏的星号保持无实体底色；编号位置不动，选择圈直接覆盖原编号（与原有验收一致）。 */
+[data-video-actions] > button:not([aria-pressed="true"]):hover {
+    background: var(--primary) !important;
+    color: var(--primary-foreground) !important;
+}
+[data-video-tile][data-status="生成中"]::before {
+    content: "";
+    position: absolute;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 4;
+    height: 3px;
+    pointer-events: none;
+    background: var(--wb-live);
+    box-shadow: 0 0 12px var(--wb-live);
