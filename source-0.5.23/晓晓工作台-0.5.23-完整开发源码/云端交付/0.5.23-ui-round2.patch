+    line-height: 1.8;
+    color: var(--text-2);
+}
+.dp-ov-rule {
+    padding: 8px 10px;
+    border-radius: 8px;
+    background: var(--sunken);
+    color: var(--text-2);
+    font-size: 12px;
+    line-height: 1.6;
+}
+.dp-ov-body nav {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+    margin-top: auto;
+    padding-top: 4px;
+}
+.dp-ov-body nav a {
+    padding: 6px 12px;
+    border-radius: 8px;
+    background: var(--soft);
+    color: var(--soft-text);
+    font-size: 12px;
+    font-weight: 600;
+}
+.dp-ov-body nav a:first-child {
+    background: var(--primary);
+    color: var(--on-primary);
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .dp-root *,
+    .dp-overview * {
+        transition: none !important;
+        animation: none !important;
+    }
+}
+@media (max-width: 900px) {
