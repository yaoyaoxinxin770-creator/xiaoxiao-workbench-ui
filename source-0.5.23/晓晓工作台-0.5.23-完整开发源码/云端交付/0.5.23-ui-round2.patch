+    },
+    {
+        id: "noir",
+        code: "B",
+        name: "胭脂墨黑",
+        tagline: "胭脂粉 × 墨黑撞色，最吸睛的暗色工作台",
+        summary: "纯墨黑底色配胭脂粉 #FF7CA2：选中项、主按钮和关键状态用整块胭脂粉配黑字，其余保持墨黑与细线。画面最突出，夜间审片不刺眼，生成中用胭脂粉光晕表达。",
+        points: ["墨黑 #000000 底，视频与封面对比度最高", "胭脂粉 #FF7CA2 整块高亮：选中、主按钮、进度", "四角星 ✦ 点缀，撞色但不杂色"],
