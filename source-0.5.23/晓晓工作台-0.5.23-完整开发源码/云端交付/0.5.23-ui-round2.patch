+        inset 0 0 0 2px var(--primary),
+        inset 0 0 26px -8px color-mix(in srgb, var(--primary) 70%, transparent);
+}
+[data-video-tile][data-agent-target] [data-video-number]::after {
+    content: "Agent";
+    margin-left: 6px;
+    padding: 1px 6px;
+    border-radius: 999px;
