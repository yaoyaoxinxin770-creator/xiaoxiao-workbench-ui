{
  "manifest_version": 3,
  "name": "小云雀工作台连接器",
  "version": "0.20.9",
  "description": "自动连接晓晓的AI工作台与已登录的小云雀画布，定位原视频节点并通过官网按钮发送。",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://xyq.jianying.com/*",
    "http://127.0.0.1:17842/*"
  ],
  "action": {
    "default_title": "小云雀工作台连接状态",
    "default_popup": "xyq-connector.html"
  },
  "background": {
    "service_worker": "xyq-service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xyq.jianying.com/project*"
      ],
      "js": [
        "xyq-auto-connect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
